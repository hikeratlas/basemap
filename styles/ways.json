{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/ways.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
    {
      "id": "park-minor-casing",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "minor", "service", "track", "residential", "unclassified"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "zinc-300",
        "line-opacity": {"stops": [[12, 0], [12.5, 1]]},
        "line-width": {"base": 1.2, "stops": [[8, 1.5], [20, 17]]}
      }
    },
    {
      "id": "park-secondary-tertiary-casing",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "secondary", "tertiary"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-500",
        "line-opacity": 1,
        "line-width": {"base": 1.2, "stops": [[8, 1.5], [20, 17]]}
      }
    },
    {
      "id": "park-primary-casing",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "primary"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-500",
        "line-opacity": {"stops": [[7, 0], [8, 1]]},
        "line-width": {
          "base": 1.2,
          "stops": [[7, 0], [8, 0.6], [9, 1.5], [20, 22]]
        }
      }
    },
    {
      "id": "park-trunk-casing",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "trunk"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-500",
        "line-opacity": {"stops": [[5, 0], [6, 1]]},
        "line-width": {
          "base": 1.2,
          "stops": [[5, 0], [6, 0.6], [7, 1.5], [20, 22]]
        }
      }
    },
    {
      "id": "park-motorway-casing",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "minzoom": 4,
      "filter": [
        "all",
        ["==", "in_park", true],
        ["==", "kind", "motorway"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-500",
        "line-opacity": {"stops": [[4, 0], [5, 1]]},
        "line-width": {
          "base": 1.2,
          "stops": [[4, 0], [5, 0.4], [6, 0.6], [7, 1.5], [20, 22]]
        }
      }
    },
    {
      "id": "park-minor",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "minor", "service", "track", "residential", "unclassified"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 1,
        "line-width": {"base": 1.2, "stops": [[6.5, 0], [8, 0.5], [20, 13]]}
      }
    },
    {
      "id": "park-secondary-tertiary",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "secondary", "tertiary"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-200",
        "line-width": {"base": 1.2, "stops": [[6.5, 0], [8, 0.5], [20, 13]]}
      }
    },
    {
      "id": "park-primary",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "primary"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-200",
        "line-width": {"base": 1.2, "stops": [[8.5, 0], [9, 0.5], [20, 18]]}
      }
    },
    {
      "id": "park-trunk",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["in", "kind", "trunk"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "yellow-200",
        "line-width": {"base": 1.2, "stops": [[6.5, 0], [7, 0.5], [20, 18]]}
      }
    },
    {
      "id": "park-motorway",
      "type": "line",
      "filter": [
        "all",
        ["==", "kind", "motorway"],
        ["==", "in_park", true]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": "yellow-400",
        "line-width": {"base": 1.2, "stops": [[6.5, 0], [7, 0.5], [20, 18]]},
        "line-opacity": 1
      },
      "layout": {"line-cap": "round", "line-join": "round"},
      "source-layer": "road",
      "source": "tiles"
    },
    {
      "id": "urban-roads",
      "type": "line",
      "filter": [
        "all",
        ["==", "in_park", false]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": {"stops": [[7, "zinc-300"], [8, "zinc-400"]]},
        "line-width": {"stops": [[7, 1]]},
        "line-opacity": 1
      },
      "layout": {"line-cap": "round", "line-join": "round"},
      "source-layer": "road",
      "source": "tiles"
    },
    {
      "id": "park-paths-bridge",
      "type": "line",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["==", "bridge", "yes"]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": "zinc-800",
        "line-width": 10,
        "line-opacity": 1
      },
      "minzoom": 11,
      "layout": {"line-join": "round"},
      "source-layer": "path",
      "source": "tiles"
    },
    {
      "id": "park-paths",
      "type": "line",
      "filter": [
        "all",
        ["!in", "kind", "ferry", "cable_car"],
        ["==", "in_park", true],
        ["!=", "canoe", "portage"],
        ["!=", "mtb", true],
        ["!=", "foot", "no"]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": {"stops": [[7, "red-800"]]},
        "line-width": {"stops": [[8, 1], [10, 2]]},
        "line-opacity": 1,
        "line-dasharray": [3,2],
        "line-gap-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 0,
          14, 1
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // Mountain bike trails walkers may also use: hiking-trail dashes in amber, so expect bikes.
      "id": "park-paths-mtb",
      "type": "line",
      "filter": [
        "all",
        ["!in", "kind", "ferry", "cable_car"],
        [
          "==",
          "in_park",
          true
        ],
        [
          "!=",
          "canoe",
          "portage"
        ],
        [
          "==",
          "mtb",
          true
        ],
        [
          "!=",
          "foot",
          "no"
        ]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": "amber-600",
        "line-width": {
          "stops": [
            [
              8,
              1
            ],
            [
              10,
              2
            ]
          ]
        },
        "line-opacity": 1,
        "line-dasharray": [
          3,
          2
        ],
        "line-gap-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0,
          14,
          1
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // Bike-only trails (foot=no): a solid amber line, no dashes, since walking routes avoid them.
      "id": "park-paths-bike-only",
      "type": "line",
      "filter": [
        "all",
        ["!in", "kind", "ferry", "cable_car"],
        [
          "==",
          "in_park",
          true
        ],
        [
          "==",
          "foot",
          "no"
        ]
      ],
      "paint": {
        "line-blur": 0.5,
        "line-color": "amber-600",
        "line-width": {
          "stops": [
            [
              8,
              1
            ],
            [
              10,
              1.5
            ],
            [
              14,
              2.5
            ]
          ]
        },
        "line-opacity": 1
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // Ferries and cable cars on trails (e.g. the West Coast Trail): a short
      // dotted line in water blue, so it reads as a crossing, not a trail.
      "id": "crossings",
      "type": "line",
      "filter": [
        "in",
        "kind",
        "ferry",
        "cable_car"
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "sky-800",
        "line-width": 2,
        "line-dasharray": [
          1,
          1.5
        ]
      },
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // Trail names sit on the trail, along a copy of it simplified by ~6 px
      // at each zoom (path_name, path_name_15 and path_name_16 in
      // slices/ways.json). MapLibre drops a line label wherever its line bends
      // sharply under the text, which on a switchbacking trail is nearly
      // everywhere; the simplified line is straight enough on straight-ish
      // stretches, and the text and its halo cover the trail it strays from.
      "id": "park-paths-names",
      "type": "symbol",
      "maxzoom": 15,
      "filter": [
        "all",
        ["==", "in_park", true],
        ["!=", "canoe", "portage"]
      ],
      "paint": {
        "text-color": "#3b2314",
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 2.5
      },
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular"],
        "text-field": "{name}",
        "text-size": 14
      },
      "source-layer": "path_name",
      "source": "tiles"
    },
    {
      "id": "park-paths-names-15",
      "type": "symbol",
      "minzoom": 15,
      "maxzoom": 16,
      "paint": {
        "text-color": "#3b2314",
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 2.5
      },
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular"],
        "text-field": "{name}",
        "text-size": 14
      },
      "source-layer": "path_name_15",
      "source": "tiles"
    },
    {
      "id": "park-paths-names-16",
      "type": "symbol",
      "minzoom": 16,
      "paint": {
        "text-color": "#3b2314",
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 2.5
      },
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular"],
        "text-field": "{name}",
        "text-size": 14
      },
      "source-layer": "path_name_16",
      "source": "tiles"
    },
    {
      "id": "park-paths-portage",
      "type": "line",
      "filter": [
        "all",
        ["==", "in_park", true],
        ["==", "canoe", "portage"]
      ],
      "minzoom": 12,
      "paint": {
        "line-blur": 1,
        "line-color": {"stops": [[7, "red-800"]]},
        "line-width": 3,
        "line-opacity": 1,
        "line-dasharray": [4,3]
      },
      "layout": {"line-cap": "round", "line-join": "round"},
      "source-layer": "path",
      "source": "tiles"
    },

    {
      "id": "city-park-paths",
      "type": "line",
      "filter": [
        "all",
        ["!in", "kind", "ferry", "cable_car"],
        ["==", "in_park", false],
        [
          "any",
          ["==", "in_city_park", true],
          ["has", "name"]
        ]
     ,
        ["!=", "mtb", true],
        ["!=", "foot", "no"]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": {"stops": [[7, "rose-500"]]},
        "line-width": {"stops": [[8, 1], [14, 2]]},
        "line-opacity": 1
      },
      "layout": {"line-cap": "round", "line-join": "round"},
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // As park-paths-mtb, outside parks.
      "id": "city-park-paths-mtb",
      "type": "line",
      "filter": [
        "all",
        ["!in", "kind", "ferry", "cable_car"],
        [
          "==",
          "in_park",
          false
        ],
        [
          "any",
          [
            "==",
            "in_city_park",
            true
          ],
          [
            "has",
            "name"
          ]
        ],
        [
          "==",
          "mtb",
          true
        ],
        [
          "!=",
          "foot",
          "no"
        ]
      ],
      "paint": {
        "line-blur": 1,
        "line-color": "amber-600",
        "line-width": {
          "stops": [
            [
              8,
              1
            ],
            [
              14,
              2
            ]
          ]
        },
        "line-opacity": 1,
        "line-dasharray": [
          3,
          2
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // As park-paths-bike-only, outside parks.
      "id": "city-park-paths-bike-only",
      "type": "line",
      "filter": [
        "all",
        ["!in", "kind", "ferry", "cable_car"],
        [
          "==",
          "in_park",
          false
        ],
        [
          "any",
          [
            "==",
            "in_city_park",
            true
          ],
          [
            "has",
            "name"
          ]
        ],
        [
          "==",
          "foot",
          "no"
        ]
      ],
      "paint": {
        "line-blur": 0.5,
        "line-color": "amber-600",
        "line-width": {
          "stops": [
            [
              8,
              1
            ],
            [
              14,
              2.5
            ]
          ]
        },
        "line-opacity": 1
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "source-layer": "path",
      "source": "tiles"
    },
    {
      // Bicycle icons along bike-only trails, so the solid amber line
      // isn't mistaken for a road or boundary.
      "id": "bike-only-icons",
      "type": "symbol",
      "filter": [
        "all",
        [
          "==",
          "foot",
          "no"
        ],
        [
          "any",
          [
            "==",
            "in_park",
            true
          ],
          [
            "==",
            "in_city_park",
            true
          ],
          [
            "has",
            "name"
          ]
        ]
      ],
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 220,
        "icon-image": "bicycle",
        "icon-size": 1.3,
        "icon-rotation-alignment": "viewport",
        "icon-allow-overlap": false
      },
      "paint": {
        "icon-color": "amber-700",
        "icon-halo-color": "white",
        "icon-halo-width": 1.5
      },
      "source-layer": "path",
      "source": "tiles"
    }

  ]
}
