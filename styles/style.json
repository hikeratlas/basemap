{
  "version": 8,
  "id": "root-style",
  "name": "root-style",
  "metadata": {
    "license": "https://creativecommons.org/publicdomain/zero/1.0/"
  },
  "glyphs": "https://public.hikeratlas.com/fonts/{fontstack}/{range}.pbf",
  // "default" is the SDF icon sheet (unprefixed names, recoloured with
  // icon-color); "patterns" holds full-colour fill/line patterns, referenced
  // as "patterns:<name>". MapLibre can't use SDF images as patterns, and one
  // sheet can't mix the two. See hikeratlas/sprites.
  "sprite": [
    {"id": "default", "url": "https://raw.githubusercontent.com/hikeratlas/sprites/main/output/sprite"},
    {"id": "patterns", "url": "https://raw.githubusercontent.com/hikeratlas/sprites/main/output/patterns"}
  ],
  "sources": {
    "terrain": {
      // Mapterhorn (https://mapterhorn.com/): Terrarium-encoded 512 px tiles
      // from national lidar where it exists (US 1 m, Canada's HRDEM 2 m; z16
      // and z15), USGS 10 m across the US, and Copernicus 30 m elsewhere,
      // e.g. Banff, Yoho and Kananaskis (z12). Below a region's coverage tiles
      // 404, and the hillshade overzooms the parent. See #171.
      "tiles": [
        "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"
      ],
      "type": "raster-dem",
      "attribution": "<a href='https://mapterhorn.com/attribution'>© Mapterhorn</a>",
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 16
    },
    // Contour lines, generated in the browser from the Mapterhorn DEM by
    // maplibre-contour; the website registers the dem-contour:// protocol
    // (hikeratlas/website app/components/Map.tsx). Without it, this source
    // just fails to load and the rest of the map is unaffected.
    //
    // thresholds: zoom*minor*major intervals in metres, used from that zoom up.
    // overzoom=1 + subsampleBelow=256 build each tile from the next-lower DEM
    // zoom, upsampled: in flat terrain (Killarney) 10 m contours otherwise
    // trace DEM pixels as staircases.
    //
    // contourLayer is "contours-15" because mapt orders layers by source-layer,
    // and learns a root-style z-index from a "-N" suffix on a layer id (see the
    // "contours-15" layer below): 15 puts contours above land and parks (2-11)
    // and under water (20), so lakes hide them.
    "contours": {
      "type": "vector",
      "tiles": [
        "dem-contour://{z}/{x}/{y}?buffer=1&overzoom=1&subsampleBelow=256&contourLayer=contours-15&elevationKey=ele&extent=4096&levelKey=level&thresholds=11*100*500~12*50*200~13*20*100~14*10*50"
      ],
      // No layer shows contours below z11; don't make MapLibre compute them.
      "minzoom": 11,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background-0",
      "type": "background",
      "paint": {"background-color": "#f1f8f3"}
    },
    {
      "id": "hillshading-50",
      "source": "terrain",
      "type": "hillshade",
      "minzoom": 7,
      // No maxzoom: relief matters most at trail-reading zooms.
      "paint": {
        //"hillshade-exaggeration": 0.1,
        "hillshade-exaggeration": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.1,
          14, 0.5,
          // Ease off at trail zooms so steep slopes don't swamp trails.
          16, 0.35
        ],
        // Mint chip: chocolate shadows, so slopes read as chocolate on mint.
        "hillshade-shadow-color": "#4a3020",
        "hillshade-accent-color": "#5a4030",
        "hillshade-highlight-color": "#ffffff"
      }
    },
    {
      // level 0: minor interval; level 1: major (see thresholds above).
      // The id doubles as mapt's z-index registration for the "contours-15"
      // source-layer that all three contour layers share.
      "id": "contours-15",
      "source": "contours",
      "source-layer": "contours-15",
      "type": "line",
      "filter": ["==", ["get", "level"], 0],
      "minzoom": 12,
      "paint": {
        "line-color": "#8a5a36",
        "line-opacity": 0.3,
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 16, 0.8]
      }
    },
    {
      "id": "contour-major",
      "source": "contours",
      "source-layer": "contours-15",
      "type": "line",
      "filter": [">", ["get", "level"], 0],
      "minzoom": 11,
      "paint": {
        "line-color": "#8a5a36",
        "line-opacity": 0.5,
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 16, 1.4]
      }
    },
    {
      "id": "contour-labels",
      "source": "contours",
      "source-layer": "contours-15",
      "type": "symbol",
      "filter": [">", ["get", "level"], 0],
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["concat", ["to-string", ["get", "ele"]], " m"],
        "text-font": ["Hubot Sans-Regular"],
        "text-size": 10,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "#8a5a36",
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 1.5
      }
    }
  ]
}
