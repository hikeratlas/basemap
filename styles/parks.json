{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/parks.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
    // Protected areas: a solid fill at low zooms. From z10 the fill fades, so
    // the land cover inside shows, and an edge line plus a translucent band
    // just inside it (line-offset into the polygon) mark the boundary, even
    // where the park sits in forest of much the same green.
    {
      "id": "park-fill",
      "type": "fill",
      "paint": {
        "fill-color": "emerald-200",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 9, 1, 11, 0.25, 13, 0.12]
      },
      "source-layer": "park",
      "source": "tiles"
    },
    {
      "id": "park-band",
      "type": "line",
      "filter": ["all", ["!=", "leisure", "park"], ["!=", "landuse", "recreation_ground"]],
      "layout": {"line-join": "round"},
      "paint": {
        "line-color": "emerald-700",
        "line-opacity": 0.4,
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 5, 14, 10],
        // Half the width, so the band sits just inside the boundary: outer
        // rings and holes both have the park on their right.
        "line-offset": ["interpolate", ["linear"], ["zoom"], 11, 2.5, 14, 5]
      },
      "minzoom": 11,
      "source-layer": "park",
      "source": "tiles"
    },
    {
      "id": "park-edge",
      "type": "line",
      "filter": ["all", ["!=", "leisure", "park"], ["!=", "landuse", "recreation_ground"]],
      "layout": {"line-join": "round"},
      "paint": {
        "line-color": "emerald-900",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.8, 14, 1.8]
      },
      "minzoom": 9,
      "source-layer": "park",
      "source": "tiles"
    },
    // City parks and recreation grounds stay filled at every zoom. A park that's
    // also a protected area (e.g. Cherry Creek State Park, leisure=park +
    // boundary=protected_area) is treated as one: park-fill fades from z10,
    // so its land (beaches, forest...) shows through, inside an outline.
    {
      "id": "leisure-park-fill",
      "type": "fill",
      "filter": [
        "all",
        [
          "any",
          ["==", "leisure", "park"],
          ["==", "landuse", "recreation_ground"]
        ],
        ["!has", "boundary"]
      ],
      "paint": {
        "fill-color": "emerald-200"
      },
      "source-layer": "park",
      "source": "tiles"
    },

    {
      "id": "label-park",
      "type": "symbol",
      "filter": ["all", ["!=", "leisure", "park"]],
      "layout": {
        "text-field": "{short_name}",
        "symbol-placement": "point",
        "text-anchor": "center",
        "text-size": [
          "case",
          [">", ["get", "rank"], 100000],
          20,
          [">", ["get", "rank"], 10000],
          15,
          10
        ],
        "text-font": ["Metropolis Semi Bold"],
        "symbol-sort-key": [
          "case",
          ["has", "rank"], ["-", ["get", "rank"]],
          0
        ]
      },
      "paint": {
        "text-halo-color": "zinc-100",
        "text-halo-width": 2,
        "text-halo-blur": 1,
        "text-color": "yellow-900"
      },
      "minzoom": 0,
      "source-layer": "park_name",
      "source": "tiles"
    }
  ]
}
