{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/peaks.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
   {
      "id": "peak",
      "type": "symbol",
      "layout": {
        "symbol-placement": "point",
        "icon-optional": true,
        "text-font": ["Hubot Sans-Regular"],
        "text-optional": true,
        "icon-image": "mountain",
        // From z12: name, then elevation (metres) smaller on the next line.
        // Below z12 just the name, to keep the overview light. ele arrives as
        // a string in the tiles, hence to-number.
        "text-field": [
          "step", ["zoom"],
          ["coalesce", ["get", "name"], ""],
          12,
          [
            "case",
            ["has", "ele"],
            [
              "format",
              ["coalesce", ["get", "name"], ""], {},
              ["case", ["has", "name"], "\n", ""], {},
              ["concat", ["to-string", ["round", ["to-number", ["get", "ele"]]]], " m"], {"font-scale": 0.8}
            ],
            ["coalesce", ["get", "name"], ""]
          ]
        ],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 12, 14, 15],
        // Higher peaks win label collisions (lower sort key places first).
        // The tiles keep only the 3 highest peaks per tile below z14 (see
        // slices/peaks.json), so z10 isn't crowded.
        "symbol-sort-key": ["-", 0, ["to-number", ["coalesce", ["get", "ele"], 0]]],
        "text-anchor": "top",
        "text-offset": [0, 0.5]
      },
      "paint": {
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 1.5,
        "text-color": "#3b2314",
        "icon-color": "#3b2314"
      },
      "minzoom": 10,
      "source-layer": "peak",
      "source": "tiles"
   }
  ]
}
