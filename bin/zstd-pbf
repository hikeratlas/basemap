#!/usr/bin/env bash
# Writes the zstd copy of a PBF that the builds read: the same data, minus
# the version and timestamp metadata that tilemaker never reads, with zstd
# blocks instead of zlib ones (cldellow/tilemaker reads both). osmium can't
# write zstd blocks, so it writes uncompressed ones to bin/pbf-zstd.ts.
#
#   bin/zstd-pbf <in.pbf> <out.zstd.pbf>
set -euo pipefail
osmium cat "$1" -f pbf,add_metadata=false,pbf_compression=none -o - \
  | bun "$(dirname "$0")/pbf-zstd.ts" - "$2"
ls -l "$1" "$2"
