{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/water.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
    {
      "id": "lakes",
      "type": "fill",
      "paint": {
        "fill-color": "sky-500"
      },
      "source-layer": "water_poly",
      "source": "tiles"
    },
    {
      "id": "rivers",
      "type": "line",
      "paint": {
        "line-color": "sky-500",
        "line-width": 1
      },
      "source-layer": "water_line",
      "source": "tiles"
    },
    {
      "id": "weirs",
      "type": "line",
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "slate-600",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1.5, 16, 4]
      },
      "minzoom": 13,
      "source-layer": "water_barrier",
      "source": "tiles"
    },
    {
      "id": "weir-points",
      "type": "circle",
      "filter": ["==", ["geometry-type"], "Point"],
      "paint": {
        "circle-color": "slate-600",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 13, 2, 16, 4],
        "circle-stroke-color": "zinc-100",
        "circle-stroke-width": 1
      },
      "minzoom": 13,
      "source-layer": "water_barrier",
      "source": "tiles"
    },
    {
      "id": "weir-labels",
      "type": "symbol",
      "filter": ["has", "name"],
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "point",
        "text-font": ["Hubot Sans-Regular"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 0.6]
      },
      "paint": {
        "text-color": "slate-700",
        "text-halo-color": "zinc-100",
        "text-halo-width": 1.5
      },
      "minzoom": 14,
      "source-layer": "water_barrier",
      "source": "tiles"
    }
  ]
}
