{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/land.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
    {
      "id": "grass-or-meadow",
      "type": "fill",
      "paint": {
        "fill-color": "green-100"
      },
      "source-layer": "land",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "landuse", "grass"],
        ["==", "landuse", "meadow"],
        ["==", "natural", "grassland"]
      ]
    },
    {
      "id": "forest",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "wood"],
        ["==", "landuse", "forest"]
      ],
      "paint": {
        "fill-color": "green-300"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "scrub-or-heath",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "scrub"],
        ["==", "natural", "heath"]
      ],
      "paint": {
        "fill-color": "green-200"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "moist-things",
      "type": "fill",
      "filter": [
        "any",
        ["has", "wetland"]
      ],
      // Pale teal, not water blue: wetlands are walkable-ish ground, and in
      // places like Killarney they'd otherwise read as hundreds of lakes.
      "paint": {
        "fill-color": "teal-100"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "moist-things-edge",
      "type": "line",
      "filter": [
        "any",
        ["has", "wetland"]
      ],
      "paint": {
        "line-color": "teal-600",
        "line-width": 1,
        "line-dasharray": [2, 2]
      },
      "minzoom": 13,
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "sandy-things",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "beach"],
        ["==", "natural", "sand"]
      ],
      "paint": {
        "fill-color": "amber-200"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "scree",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "scree"]
      ],
      "paint": {
        "fill-color": "zinc-300"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "bare_rock",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "bare_rock"]
      ],
      "paint": {
        "fill-color": "zinc-200"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "glacier",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "glacier"]
      ],
      "paint": {
        "fill-color": "indigo-100"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "camp-site",
      "type": "fill",
      "paint": {
        "fill-color": "green-100"
      },
      "source-layer": "land",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "tourism", "camp_site"]
      ]
    },
    {
      "id": "cliff",
      "type": "line",
      "paint": {
        "line-color": "zinc-400",
        "line-width": 3,
        "line-opacity": 1
      },
      "source-layer": "land_line",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "natural", "cliff"]
      ]
    },
    {
      "id": "cemetery",
      "type": "fill",
      "paint": {
        "fill-color": "green-100"
      },
      "source-layer": "land",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "landuse", "cemetery"]
      ]
    },
    {
      // Canyon, gorge and valley names, along the valley floor or the rim.
      "id": "landform-labels",
      "type": "symbol",
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 14, 13],
        "text-letter-spacing": 0.15,
        "text-max-angle": 45,
        "symbol-spacing": 500
      },
      "paint": {
        "text-color": "stone-700",
        "text-halo-color": "zinc-50",
        "text-halo-width": 1.5
      },
      "minzoom": 11,
      "source-layer": "landform_name",
      "source": "tiles"
    }
  ]
}
