{
    "layers": {
        "trail_area": {
            "minzoom": 8,
            "maxzoom": 14,
            "source": "../trail-areas.geojsonl",
            "source_columns": [
                "name",
                "osm_id",
                "km",
                "area"
            ],
            "simplify_below": 12,
            "simplify_level": 0.0002
        }
    },
    "settings": {
        "minzoom": 0,
        "maxzoom": 14,
        "basezoom": 14,
        "include_ids": false,
        "name": "Shortbread",
        "version": "1.0",
        "description": "Trail areas (bin/trail-areas.py), for hikeratlas/routes only: not joined into the map",
        "compress": "zstd",
        "filemetadata": {
            "tilejson": "2.0.0",
            "scheme": "xyz",
            "type": "baselayer",
            "format": "pbf",
            "tiles": [
                "https://example.com/liechtenstein/{z}/{x}/{y}.pbf"
            ]
        }
    }
}
