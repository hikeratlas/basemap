{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/land.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
    {
      "id": "grass-or-meadow",
      "type": "fill",
      "paint": {
        "fill-color": "#d6f3e0"
      },
      "source-layer": "land",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "landuse", "grass"],
        ["==", "landuse", "meadow"],
        ["==", "natural", "grassland"]
      ]
    },
    {
      "id": "forest",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "wood"],
        ["==", "landuse", "forest"]
      ],
      "paint": {
        "fill-color": "#9fe0b8"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "scrub-or-heath",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "scrub"],
        ["==", "natural", "heath"]
      ],
      "paint": {
        "fill-color": "#bfe9cd"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "moist-things",
      "type": "fill",
      "filter": [
        "any",
        ["has", "wetland"]
      ],
      // Pale teal, not water blue: wetlands are walkable-ish ground, and in
      // places like Killarney they'd otherwise read as hundreds of lakes.
      "paint": {
        "fill-color": "#d5f5ee"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      // Horizontal dashes, the usual wetland symbol (openstreetmap-carto's CC0
      // pattern, via hikeratlas/sprites). The tiles don't keep wetland=*
      // subtypes (land.lua emits "natural=wetland"), so it's one pattern for all.
      "id": "moist-things-texture",
      "type": "fill",
      "filter": [
        "any",
        ["has", "wetland"]
      ],
      "paint": {
        "fill-pattern": "patterns:wetland"
      },
      "minzoom": 12,
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "moist-things-edge",
      "type": "line",
      "filter": [
        "any",
        ["has", "wetland"]
      ],
      "paint": {
        "line-color": "teal-600",
        "line-width": 1,
        "line-dasharray": [2, 2]
      },
      "minzoom": 13,
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "sandy-things",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "beach"],
        ["==", "natural", "sand"]
      ],
      "paint": {
        "fill-color": "#f5e3b0"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "scree",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "scree"]
      ],
      "paint": {
        "fill-color": "zinc-300"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      // Stipple of small stones over the scree colour (openstreetmap-carto's
      // CC0 pattern, via hikeratlas/sprites).
      "id": "scree-texture",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "scree"]
      ],
      "paint": {
        "fill-pattern": "patterns:scree"
      },
      "minzoom": 12,
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "bare_rock",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "bare_rock"]
      ],
      "paint": {
        "fill-color": "zinc-200"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      // Faint rock texture, so bare rock reads differently from scree.
      "id": "bare-rock-texture",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "bare_rock"]
      ],
      "paint": {
        "fill-pattern": "patterns:rock"
      },
      "minzoom": 12,
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "glacier",
      "type": "fill",
      "filter": [
        "any",
        ["==", "natural", "glacier"]
      ],
      "paint": {
        "fill-color": "#e6ecff"
      },
      "source-layer": "land",
      "source": "tiles"
    },
    {
      "id": "camp-site",
      "type": "fill",
      "paint": {
        "fill-color": "#d6f3e0"
      },
      "source-layer": "land",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "tourism", "camp_site"]
      ]
    },
    {
      "id": "cliff",
      "type": "line",
      // A line with ticks on the downhill side (OSM draws cliffs with the
      // drop on the right of the way's direction). The pattern's height sets
      // the line width (9 and 13 px, including 1px padding rows); cliff2 is the
      // larger version for close zooms.
      "paint": {
        "line-pattern": ["step", ["zoom"], "patterns:cliff", 15, "patterns:cliff2"],
        "line-width": ["step", ["zoom"], 9, 15, 13]
      },
      "source-layer": "land_line",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "natural", "cliff"]
      ]
    },
    {
      "id": "cemetery",
      "type": "fill",
      "paint": {
        "fill-color": "#d6f3e0"
      },
      "source-layer": "land",
      "source": "tiles",
      "filter": [
        "any",
        ["==", "landuse", "cemetery"]
      ]
    },
    {
      // Canyon, gorge and valley names, along the valley floor or the rim.
      "id": "landform-labels",
      "type": "symbol",
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 14, 13],
        "text-letter-spacing": 0.15,
        "text-max-angle": 45,
        "symbol-spacing": 500
      },
      "paint": {
        "text-color": "#3b2314",
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 1.5
      },
      "minzoom": 11,
      "source-layer": "landform_name",
      "source": "tiles"
    }
  ]
}
