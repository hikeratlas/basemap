#!/bin/bash
set -euo pipefail

fname_style="/tmp/basemap_$$_style.json"

function finish {
	rm -f "${fname_style}"
}
trap finish EXIT

bun mapt style https://public.hikeratlas.com/north-america.pmtiles > "${fname_style}"
"$(dirname "$0")"/pin-sprites "${fname_style}"
# NB: the CI workflows also upload with Cache-Control: no-cache, so browsers
# revalidate the style on every load. Set the same here if r2cmd supports it;
# otherwise a manual publish leaves style.json without that header.
r2cmd put --force "${fname_style}" s3://hikes-public/style.json
