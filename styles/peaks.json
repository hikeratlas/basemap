{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/peaks.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
   {
      "id": "peak",
      "type": "symbol",
      "layout": {
        "symbol-placement": "point",
        "icon-optional": true,
        "text-font": ["Hubot Sans-Regular"],
        "text-optional": true,
        "icon-image": "mountain",
        // Name, then elevation (metres) smaller on the next line. ele arrives
        // as a string in the tiles, hence to-number.
        "text-field": [
          "case",
          ["has", "ele"],
          [
            "format",
            ["coalesce", ["get", "name"], ""], {},
            ["case", ["has", "name"], "\n", ""], {},
            ["concat", ["to-string", ["round", ["to-number", ["get", "ele"]]]], " m"], {"font-scale": 0.8}
          ],
          ["coalesce", ["get", "name"], ""]
        ],
        "text-anchor": "top",
        "text-offset": [0, 0.5]
      },
      "paint": {
        "text-halo-color": "#f1f8f3",
        "text-halo-width": 1.5,
        "text-color": "#3b2314",
        "icon-color": "#3b2314"
      },
      "minzoom": 12,
      "source-layer": "peak",
      "source": "tiles"
   }
  ]
}
