{
  "version": 8,
  "id": "hikeratlas",
  "name": "hikeratlas",
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/sprite/sprite",
  "sources": {
    "tiles": {
      "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors",
      "url": "pmtiles://http://localhost:8081/water.pmtiles",
      "type": "vector",
      "bounds": [-180, -85.0511287798066, 180, 85.0511287798066]
    }
  },
  "layers": [
    {
      "id": "lakes",
      "type": "fill",
      "paint": {
        "fill-color": "sky-500"
      },
      "source-layer": "water_poly",
      "source": "tiles"
    },
    {
      "id": "rivers",
      "type": "line",
      "paint": {
        "line-color": "sky-500",
        "line-width": 1
      },
      "source-layer": "water_line",
      "source": "tiles"
    },
    {
      "id": "dams",
      "type": "fill",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "slate-400",
        "fill-outline-color": "slate-600"
      },
      "minzoom": 12,
      "source-layer": "water_barrier",
      "source": "tiles"
    },
    {
      "id": "barrier-lines",
      "type": "line",
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "slate-600",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          12, ["match", ["get", "kind"], "dam", 2, 1],
          16, ["match", ["get", "kind"], "dam", 6, 4]
        ]
      },
      "minzoom": 12,
      "source-layer": "water_barrier",
      "source": "tiles"
    },
    {
      "id": "barrier-points",
      "type": "circle",
      "filter": ["==", ["geometry-type"], "Point"],
      "paint": {
        "circle-color": "slate-600",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 12, 2, 16, 4],
        "circle-stroke-color": "zinc-100",
        "circle-stroke-width": 1
      },
      "minzoom": 12,
      "source-layer": "water_barrier",
      "source": "tiles"
    },
    {
      "id": "barrier-labels",
      "type": "symbol",
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "point",
        "text-font": ["Hubot Sans-Regular"],
        "text-size": ["match", ["get", "kind"], "dam", 12, 11],
        "text-anchor": "top",
        "text-offset": [0, 0.6]
      },
      "paint": {
        "text-color": "slate-700",
        "text-halo-color": "zinc-100",
        "text-halo-width": 1.5
      },
      "minzoom": 13,
      "source-layer": "water_barrier_name",
      "source": "tiles"
    },
    {
      "id": "lake-labels",
      "type": "symbol",
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 14, 15],
        "text-letter-spacing": 0.1,
        "text-max-angle": 45,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "sky-800",
        "text-halo-color": "sky-100",
        "text-halo-width": 1.5
      },
      "minzoom": 6,
      "source-layer": "lake_centerline",
      "source": "tiles"
    },
    {
      // Lakes too small for a centerline: their name at a point, from z12 to
      // z14 depending on size (see water.lua).
      "id": "lake-point-labels",
      "type": "symbol",
      "filter": ["==", "point_label", true],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Hubot Sans-Regular Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 11, 15, 13],
        "text-letter-spacing": 0.1,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "sky-800",
        "text-halo-color": "sky-100",
        "text-halo-width": 1.5
      },
      "minzoom": 12,
      "source-layer": "water_poly_name",
      "source": "tiles"
    },
    {
      // River and stream names along the waterway. The tiles have carried
      // them (water_line_name) for a long time, but nothing drew them.
      "id": "river-labels",
      "type": "symbol",
      "filter": ["==", "kind", "river"],
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 14, 13],
        "text-letter-spacing": 0.1,
        "text-max-angle": 45,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "sky-800",
        "text-halo-color": "sky-100",
        "text-halo-width": 1.5
      },
      "minzoom": 10,
      "source-layer": "water_line_name",
      "source": "tiles"
    },
    {
      "id": "stream-labels",
      "type": "symbol",
      "filter": ["==", "kind", "stream"],
      "layout": {
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-font": ["Hubot Sans-Regular Italic"],
        "text-size": 11,
        "text-letter-spacing": 0.1,
        "text-max-angle": 45,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "sky-800",
        "text-halo-color": "sky-100",
        "text-halo-width": 1.5
      },
      "minzoom": 13,
      "source-layer": "water_line_name",
      "source": "tiles"
    }
  ]
}
