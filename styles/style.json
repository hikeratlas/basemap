{
  "version": 8,
  "id": "root-style",
  "name": "root-style",
  "metadata": {
    "license": "https://creativecommons.org/publicdomain/zero/1.0/"
  },
  "glyphs": "https://public.hikeratlas.com/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://raw.githubusercontent.com/hikeratlas/sprites/main/output/sprite",
  "sources": {
    "terrain": {
      "tiles": [
        "https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png"
      ],
      "type": "raster-dem",
      "attribution": "<a href='https://github.com/tilezen/joerd/blob/master/docs/attribution.md'>Tilezen Joerd: Attribution</a>",
      "encoding": "terrarium",
      // Terrarium serves z15 (z16 404s), but its z15 tiles show seams at tile
      // edges in hillshade. Overzooming z14 is seamless and looks as detailed.
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background-0",
      "type": "background",
      "paint": {"background-color": "zinc-100"}
    },
    {
      "id": "hillshading-50",
      "source": "terrain",
      "type": "hillshade",
      "minzoom": 7,
      // No maxzoom: relief matters most at trail-reading zooms.
      "paint": {
        //"hillshade-exaggeration": 0.1,
        "hillshade-exaggeration": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.1,
          14, 0.5,
          // Ease off at trail zooms so steep slopes don't swamp trails.
          16, 0.35
        ],
        //"hillshade-accent-color": "#777777",
        //"hillshade-highlight-color": "#ffffff"
      }
    }
  ]
}
